# ---- Supabase ----
# Local: values printed by `pnpm db:start` (or `pnpm exec supabase status`).
# Production: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- Anthropic (server only) ----
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_PLAN_MODEL=claude-sonnet-5-5
ANTHROPIC_CHECKIN_MODEL=claude-haiku-5-5

# ---- Limits ----
AI_PLAN_DAILY_LIMIT=3
AI_CHECKIN_WEEKLY_LIMIT=1

# ---- Testing only: deterministic fake AI (ignored when NODE_ENV=production) ----
AI_MOCK=0

# ---- Local Google OAuth (optional; read by supabase/config.toml) ----
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
